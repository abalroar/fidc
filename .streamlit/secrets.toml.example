# Modelo do arquivo de secrets da fila de taxonomia.
#
# Copie para .streamlit/secrets.toml e preencha. O arquivo real NUNCA é
# versionado: o .gitignore ignora tudo em .streamlit/ menos config.toml e este
# exemplo. Confira com `git check-ignore -v .streamlit/secrets.toml` antes de
# colar o token.
#
# O token só é usado para dar push nos dois CSV do ledger. Ele é montado numa
# URL HTTPS efêmera, passada como argumento de um único `git push`, e não é
# gravado em .git/config nem ecoado na tela — services/ledger_publisher.py
# redige qualquer credencial antes de exibir mensagem de erro.
#
# Permissão mínima num fine-grained token: Repository access = apenas
# abalroar/fidc; Repository permissions = Contents: Read and write. Nada além
# disso.

github_token = "github_pat_COLE_O_SEU_AQUI"

# Opcional. Só é necessário quando o clone não tem remote `origin` apontando
# para o GitHub — por exemplo num deploy que baixou o código de outra forma.
# github_repository = "abalroar/fidc"
