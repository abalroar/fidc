# Modelo do arquivo de secrets do app.
#
# Copie para .streamlit/secrets.toml e preencha. O arquivo real NUNCA é
# versionado: o .gitignore ignora tudo em .streamlit/ menos config.toml e este
# exemplo. Confira com `git check-ignore -v .streamlit/secrets.toml` antes de
# colar o token.
#
# Um único token serve às duas funcionalidades que escrevem no GitHub:
#
#   - cadastro de carteiras (services/portfolio_store.py), que grava
#     portfolios.json pela API de conteúdo;
#   - publicação do ledger de taxonomia (services/ledger_publisher.py), que dá
#     push nos dois CSV da curadoria.
#
# Ambas pedem exatamente a mesma permissão. Num fine-grained token:
# Repository access = apenas abalroar/fidc; Repository permissions =
# Contents: Read and write. Nada além disso.
#
# O ledger monta uma URL HTTPS efêmera com o token, passada como argumento de
# um único `git push`. Ela não é gravada em .git/config nem ecoada na tela:
# ledger_publisher.redact() limpa qualquer credencial antes de exibir erro.

github_token = "github_pat_COLE_O_SEU_AQUI"
github_repo = "abalroar/fidc"

# Onde o cadastro de carteiras grava. Sem isto, o padrão já é portfolios.json.
github_portfolios_path = "portfolios.json"

# Branch de destino. O push do ledger normalmente usa a branch que está
# checada; este valor só entra quando o deploy deixa o HEAD destacado, que é o
# caso de hosts que publicam a partir de um commit.
github_branch = "main"
